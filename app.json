{
  "expo": {
    "name": "Natural Grammar",
    "slug": "natural-grammar",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "naturalgrammar",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF9F1"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "efa59e21-db3f-4725-aa0b-d713d08fc946"
      }
    },
    "owner": "masa-practice"
  }
}
