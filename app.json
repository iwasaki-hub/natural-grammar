{
  "expo": {
    "name": "Natural Grammar",
    "slug": "natural-grammar",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "naturalgrammar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/icon.png"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-icon.png",
        "backgroundColor": "#126D65"
      }
    },
    "web": {
      "output": "server",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFF9F1",
          "dark": {
            "image": "./assets/branding/splash.png",
            "backgroundColor": "#FFF9F1"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "efa59e21-db3f-4725-aa0b-d713d08fc946"
      }
    },
    "owner": "masa-practice",
    "icon": "./assets/branding/icon.png"
  }
}
